    "/v1/me/saved-books": {
      "get": {
        "operationId": "listSavedBooks",
        "description": "Ordered by savedAt descending, then Gutenberg document ID descending (lexical). Pass nextCursor unchanged. A cursor belongs to one account.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedBooksPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or cursor.",
